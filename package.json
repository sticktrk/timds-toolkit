{
  "name": "@dtconcepts/timds",
  "version": "0.1.412",
  "description": "Versioned CLI, contracts, templates, and AI skill for repository-owned TimDS design systems.",
  "type": "module",
  "bin": {
    "timds": "bin/timds.mjs",
    "timds-publish-artifact": "scripts/publish-artifact.mjs"
  },
  "exports": {
    ".": "./src/core.mjs",
    "./artifact": "./src/artifact.mjs",
    "./auth": "./src/auth.mjs",
    "./core": "./src/core.mjs",
    "./extract": "./src/extract.mjs",
    "./html": "./src/html.mjs",
    "./media": "./src/media.mjs",
    "./video": "./src/video.mjs",
    "./video/producer": "./src/video-producer.mjs",
    "./video/remotion": "./video/remotion.tsx"
  },
  "scripts": {
    "test": "node --test src/*.test.mjs video/*.test.mjs",
    "pack:check": "npm pack --dry-run",
    "release": "./scripts/release.sh"
  },
  "files": [
    "bin",
    "scripts/publish-artifact.mjs",
    "skills",
    "src/core.mjs",
    "src/artifact.mjs",
    "src/auth.mjs",
    "src/extract.mjs",
    "src/html.mjs",
    "src/media.mjs",
    "src/video-producer.mjs",
    "src/video-producer.d.mts",
    "src/video.mjs",
    "video",
    "templates"
  ],
  "dependencies": {
    "@remotion/cli": "4.0.484",
    "@remotion/media": "4.0.484",
    "@remotion/media-parser": "4.0.484",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.484",
    "tsx": "4.21.0",
    "zod": "4.3.6"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "design-system",
    "timds",
    "workflow"
  ],
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dtconceptsnc/timds-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/dtconceptsnc/timds-toolkit/issues"
  },
  "homepage": "https://github.com/dtconceptsnc/timds-toolkit#readme",
  "publishConfig": {
    "access": "public"
  }
}
