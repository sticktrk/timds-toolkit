# .env for local development (git-ignored). Generate the key with:
#
#   npx emdash secrets generate --write .env
#
# EMDASH_ENCRYPTION_KEY encrypts plugin secrets stored in the database. It is
# never stored in the database or in a backup: keep a copy in a password
# manager. Losing it makes those encrypted values unreadable.
# On Cloudflare, set the production value with:
#
#   npx wrangler secret put EMDASH_ENCRYPTION_KEY
#
# On Node.js, set it in the host's secret manager.
EMDASH_ENCRYPTION_KEY=emdash_enc_v1_replace_with_generated_key

# On Node.js, the production origin, set where the build runs and where the
# server runs. On Cloudflare it is the EMDASH_SITE_URL var in wrangler.jsonc.
EMDASH_SITE_URL=__SITE_URL__
