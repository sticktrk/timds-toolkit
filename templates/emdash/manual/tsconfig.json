// tsconfig.json: the site's own file gains the EmDash type files in "include".
// emdash-env.d.ts is generated by `astro dev` from the content model and
// declares the `articles` collection and EmDash's Astro.locals. On Cloudflare,
// `npx wrangler types` writes worker-configuration.d.ts, which declares the
// ExportedHandler type src/worker.ts uses. Keep the site's other settings.
{
	"extends": "astro/tsconfigs/strict",
	"include": [
		".astro/types.d.ts",
		"src",
		"emdash-env.d.ts", // NEW
		"worker-configuration.d.ts", // NEW, Cloudflare only
	],
}
