// wrangler.jsonc for the EmDash article section. Merge into the site's own
// file; keys marked NEW are what EmDash needs. Wrangler creates the named D1
// database and R2 bucket on the first deploy. Worker, database and bucket
// names take lowercase letters, digits and dashes: adjust a scoped or
// otherwise unusable package name.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "__SITE_NAME__",
	// NEW: the entry that adds EmDash's scheduled handler (src/worker.ts).
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	// NEW: EmDash needs Node.js APIs. With a compatibility date on or after
	// 2025-04-01 this also fills process.env, where EmDash reads its secrets.
	"compatibility_flags": ["nodejs_compat"],
	// NEW: the database binding, named as in d1({ binding: "DB" }).
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "__SITE_NAME__",
		},
	],
	// NEW: the media bucket binding, named as in r2({ binding: "MEDIA" }).
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "__SITE_NAME__-media",
		},
	],
	// NEW: the production origin, so setup and passkeys bind to it and not to
	// a workers.dev or preview address. Use a var, not `siteUrl` in astro.config.
	// If it reads https://example.com, replace it with the real origin before
	// the first deploy, or leave the variable out until the origin is known.
	"vars": {
		"EMDASH_SITE_URL": "__SITE_URL__",
	},
	// NEW: the cron trigger that runs scheduled publishing and maintenance
	// through the scheduled handler in src/worker.ts.
	"triggers": {
		"crons": ["* * * * *"],
	},
	// No "worker_loaders" (LOADER) binding: the site uses no sandboxed plugins.
}
