---
/**
 * /articles/<slug>/: one article. The port of the Design System's
 * articles/example-article.html design.
 *
 * EmDash serves drafts only to a signed-in editor or a valid preview link
 * for this entry, so anyone else gets the 404 page for a draft, an
 * unpublished or a missing article. The status check below repeats that rule
 * so a change upstream cannot leak a draft to an anonymous visitor.
 */
import { decodeSlug, getEmDashEntry, getSeoMeta } from "emdash";

import Layout from "__LAYOUT_IMPORT__";
import ArticleBody from "../../components/articles/ArticleBody.astro";
import ArticleMeta from "../../components/articles/ArticleMeta.astro";
import TopicList from "../../components/articles/TopicList.astro";
import ArticleHead from "../../components/articles/regions/Head.astro";
import ArticleHeader from "../../components/articles/regions/Header.astro";
import BeforeBody from "../../components/articles/regions/BeforeBody.astro";
import WithinBody from "../../components/articles/regions/WithinBody.astro";
import AfterBody from "../../components/articles/regions/AfterBody.astro";
import Sidebar from "../../components/articles/regions/Sidebar.astro";
import {
	sectionForPath,
	absoluteUrl,
	articlePath,
	bylineNames,
	cacheControl,
	imageFieldUrl,
	isSignedIn,
	siteOrigin,
	sitePath,
	topicsOf,
	type ArticleData,
} from "../../lib/articles/index";

import { sectionAvailable, sectionUnavailable } from "../../lib/articles/availability";
import { articleHtml, ArticleHtmlError } from "../../lib/articles/html";
import { insertionIndex, portableTextBoundary } from "../../lib/articles/body-regions";
import { articlePresentation, organizationSchema, type ArticleRegionProps } from "../../lib/articles/presentation";
import { divisionForArticle } from "../../lib/articles/presentation-context";

export const prerender = false;

const section = sectionForPath(Astro.url.pathname);
if (!section) return Astro.rewrite("/404");
if (!await sectionAvailable(section)) return sectionUnavailable();
const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const { entry, isPreview, cacheHint, error } = await getEmDashEntry<string, ArticleData>(section.collection, slug);
if (error) throw error;
if (!entry) return Astro.rewrite("/404");
if (!isPreview && !isSignedIn(Astro.locals) && entry.data.status !== "published") return Astro.rewrite("/404");
if (Astro.request.method !== "GET" && Astro.request.method !== "HEAD") return new Response("This address accepts GET and HEAD.", { status: 405, headers: { Allow: "GET, HEAD", "Cache-Control": "no-store" } });

const { data } = entry;
const origin = siteOrigin(Astro.url, Astro.site, Astro.request);
let html: ReturnType<typeof articleHtml> | undefined;
try {
	if (data.body_html != null && typeof data.body_html !== "string") throw new ArticleHtmlError();
	if (typeof data.body_html === "string" && data.body_html.trim()) {
		html = articleHtml(data.body_html, { ...articlePresentation.html, origin });
	}
} catch (caught) {
	if (!(caught instanceof ArticleHtmlError)) throw caught;
	Astro.cache?.set(false);
	return new Response(Astro.request.method === "HEAD" ? null : "Article content is unavailable.", {
		status: 500,
		headers: { "Content-Type": "text/plain; charset=utf-8", "X-Content-Type-Options": "nosniff", "Cache-Control": "no-store" },
	});
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
Astro.response.headers.set("Cache-Control", cacheControl(Astro.locals, Astro.url, isPreview));

const coverSrc = imageFieldUrl(data.cover, Astro.locals);
const path = articlePath(entry.id, section);
const seo = getSeoMeta(entry, {
	siteUrl: origin,
	path,
	defaultDescription: data.summary ?? undefined,
	defaultOgImage: coverSrc ? absoluteUrl(coverSrc, origin) : undefined,
});
const canonical = absoluteUrl(path, origin);
const sectionUrl = absoluteUrl(sitePath(section.prefix), origin);
const publisher = organizationSchema(articlePresentation.organization, origin);
const authors = articlePresentation.author === "organization" && publisher
	? [publisher]
	: bylineNames(data).map((name) => ({ "@type": "Person", name }));
const region: ArticleRegionProps = {
	context: {
		entry, section, canonical, isPreview: Boolean(isPreview),
		presentation: { division: divisionForArticle(section.collection), origin, sectionUrl, bodyFormat: html ? "html" : "portable-text" },
	},
};
const htmlIndex = html ? insertionIndex(html.boundaries.length, articlePresentation.withinBody) : undefined;
const htmlBoundary = htmlIndex === undefined ? undefined : html?.boundaries[htmlIndex - 1];
const textBoundary = html ? undefined : portableTextBoundary(data.body, articlePresentation.withinBody);

// Escaped so the JSON can never close its own script element.
const structuredData = JSON.stringify({
	"@context": "https://schema.org",
	"@type": "Article",
	headline: seo.ogTitle || data.title,
	...(seo.description ? { description: seo.description } : {}),
	...(seo.ogImage ? { image: [seo.ogImage] } : {}),
	...(data.publishedAt ? { datePublished: data.publishedAt.toISOString() } : {}),
	dateModified: data.updatedAt.toISOString(),
	...(authors.length ? { author: authors } : {}),
	...(publisher ? { publisher } : {}),
	articleSection: section.label,
	mainEntityOfPage: canonical,
	url: canonical,
}).replace(/</g, "\\u003c");
const breadcrumbData = JSON.stringify({
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{ "@type": "ListItem", position: 1, name: "Home", item: absoluteUrl(sitePath("/"), origin) },
		{ "@type": "ListItem", position: 2, name: section.label, item: sectionUrl },
		{ "@type": "ListItem", position: 3, name: data.title, item: canonical },
	],
}).replace(/</g, "\\u003c");
---

<Layout__SECTION_LAYOUT_PROPS__ title={seo.title || data.title} description={seo.description ?? ""}>
	<Fragment slot="head">
		<link rel="canonical" href={canonical} />
		{seo.robots && <meta name="robots" content={seo.robots} />}
		<meta property="og:type" content="article" />
		<meta property="og:title" content={seo.ogTitle || data.title} />
		{seo.ogDescription && <meta property="og:description" content={seo.ogDescription} />}
		<meta property="og:url" content={canonical} />
		{seo.ogImage && <meta property="og:image" content={seo.ogImage} />}
		{seo.ogImage && data.cover?.alt && <meta property="og:image:alt" content={data.cover.alt} />}
		<meta name="twitter:card" content={seo.ogImage ? "summary_large_image" : "summary"} />
		{seo.ogImage && <meta name="twitter:image" content={seo.ogImage} />}
		{data.publishedAt && <meta property="article:published_time" content={data.publishedAt.toISOString()} />}
		<meta property="article:modified_time" content={data.updatedAt.toISOString()} />
		<script type="application/ld+json" set:html={structuredData} />
		<script type="application/ld+json" set:html={breadcrumbData} />
		<ArticleHead {...region} />
	</Fragment>

	<article>
		<header class="hero">
			<TopicList topics={topicsOf(data)} />
			<h1 {...entry.edit.title}>{data.title}</h1>
			{data.summary && <p {...entry.edit.summary}>{data.summary}</p>}
			<ArticleMeta data={data} />
			<ArticleHeader {...region} />
			{
				coverSrc && (
					<img
						src={coverSrc}
						alt={data.cover?.alt ?? ""}
						width={data.cover?.width}
						height={data.cover?.height}
						fetchpriority="high"
						{...entry.edit.cover}
					/>
				)
			}
		</header>

		<div class="article-content">
			<div>
				<BeforeBody {...region} />
				<div class="prose">
					{html ? (
						htmlBoundary === undefined ? <Fragment set:html={html.source} /> : (
							<Fragment>
								<Fragment set:html={html.source.slice(0, htmlBoundary)} />
								<WithinBody {...region} />
								<Fragment set:html={html.source.slice(htmlBoundary)} />
							</Fragment>
						)
					) : textBoundary === undefined ? <ArticleBody value={data.body} /> : (
						<Fragment>
							<ArticleBody value={data.body?.slice(0, textBoundary)} />
							<WithinBody {...region} />
							<ArticleBody value={data.body?.slice(textBoundary)} />
						</Fragment>
					)}
				</div>
				<AfterBody {...region} />
			</div>
			<Sidebar {...region} />
		</div>
	</article>

	<div class="section">
		<a class="button button--secondary" href={sitePath(section.prefix)}>Back to all {section.label.toLowerCase()}</a>
	</div>
</Layout>
