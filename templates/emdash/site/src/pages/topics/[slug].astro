---
/**
 * /topics/<slug>/: the published articles filed under one topic, newest
 * first. The port of the Design System's topics/example-topic.html design.
 * A topic that does not exist answers the 404 page.
 */
import { decodeSlug, getTaxonomyTermsWithCacheHint } from "emdash";

import Layout from "__LAYOUT_IMPORT__";
import ArticleCard from "../../components/articles/ArticleCard.astro";
import { sections, TOPIC, cacheControl, sitePath } from "../../lib/articles/index";

import { getLatestArticles } from "../../lib/articles/latest";

export const prerender = false;

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const terms = await getTaxonomyTermsWithCacheHint(TOPIC, { includeCounts: false });
const topic = terms.data.find((term) => term.slug === slug);
if (!topic) return Astro.rewrite("/404");

const cursor = Astro.url.searchParams.get("cursor") ?? undefined;
const { entries, nextCursor, cacheHints } = await getLatestArticles({ topic: topic.slug, cursor });

if (Astro.cache?.enabled) {
	Astro.cache.set(terms.cacheHint);
	for (const hint of cacheHints) Astro.cache.set(hint);
}
Astro.response.headers.set("Cache-Control", cacheControl(Astro.locals, Astro.url));

const description = topic.description || `Articles about ${topic.label}.`;
---

<Layout title={topic.label} description={description}>
	<section class="hero">
		<h1>{topic.label}</h1>
		<p>{description}</p>
	</section>

	{
		entries.length > 0 ? (
			<section class="section" id="list">
				<ul class="article-list">
					{entries.map(({ entry, section }) => (
						<ArticleCard entry={entry} section={section} />
					))}
				</ul>
			</section>
		) : (
			<section class="section" id="list">
				<h2>Nothing published yet</h2>
				<p>
					Articles filed under this topic appear here as soon as they are published. {sections.map((section, index) => <Fragment>{index > 0 && " · "}<a href={sitePath(section.prefix)}>See all {section.label.toLowerCase()}</a></Fragment>)}.
				</p>
			</section>
		)
	}

	{
		nextCursor && (
			<div class="section">
				<a class="button button--secondary" href={`?cursor=${encodeURIComponent(nextCursor)}`}>
					Older articles
				</a>
			</div>
		)
	}
</Layout>
