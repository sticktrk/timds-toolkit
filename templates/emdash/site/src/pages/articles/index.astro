---
/**
 * /articles/: published articles, newest first, 20 to a page. The port of
 * the Design System's articles.html and articles.empty.html designs.
 */
import { getEmDashCollection } from "emdash";

import Layout from "__LAYOUT_IMPORT__";
import ArticleCard from "../../components/articles/ArticleCard.astro";
import { ARTICLES, cacheControl, type ArticleData } from "../../lib/articles/index";

export const prerender = false;

const cursor = Astro.url.searchParams.get("cursor") ?? undefined;
const { entries, nextCursor, cacheHint, error } = await getEmDashCollection<typeof ARTICLES, ArticleData>(ARTICLES, {
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});
if (error) throw error;

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
Astro.response.headers.set("Cache-Control", cacheControl(Astro.locals, Astro.url));

const title = "Articles";
const description = "Notes, guides, and news, newest first.";
---

<Layout title={title} description={description}>
	<section class="hero">
		<h1>{title}</h1>
		<p>{description}</p>
	</section>

	{
		entries.length > 0 ? (
			<section class="section" id="list">
				<ul class="article-list">
					{entries.map((entry) => (
						<ArticleCard entry={entry} />
					))}
				</ul>
			</section>
		) : (
			<section class="section" id="list">
				<h2>Nothing published yet</h2>
				<p>The first articles appear here as soon as they are published.</p>
			</section>
		)
	}

	{
		nextCursor && (
			<div class="section">
				<a class="button button--secondary" href={`?cursor=${encodeURIComponent(nextCursor)}`}>
					Older articles
				</a>
			</div>
		)
	}
</Layout>
