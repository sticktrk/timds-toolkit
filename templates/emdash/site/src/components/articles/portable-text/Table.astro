---
/**
 * A table block, in the shape EmDash's editor and API store:
 *
 *   { _type: "table", hasHeaderRow?, markDefs?, rows: [
 *     { _type: "tableRow", cells: [
 *       { _type: "tableCell", content: [span...], markDefs?, isHeader?, colspan?, rowspan? } ] } ] }
 *
 * The first row becomes the thead when `hasHeaderRow` is set and every cell
 * in it is a header. Cell text keeps its marks (links, emphasis, code).
 */
import { PortableText } from "emdash/ui";

import TableCellText from "./TableCellText.astro";

interface Span {
	_type: string;
	_key?: string;
	text?: string;
	marks?: string[];
}
interface MarkDef {
	_type: string;
	_key: string;
	[key: string]: unknown;
}
interface Cell {
	_key?: string;
	content?: Span[];
	markDefs?: MarkDef[];
	isHeader?: boolean;
	colspan?: number;
	rowspan?: number;
}
interface Row {
	_key?: string;
	cells?: Cell[];
}
interface Props {
	node: { _key?: string; rows?: Row[]; hasHeaderRow?: boolean; markDefs?: MarkDef[] };
}

const { node } = Astro.props;
const rows = Array.isArray(node?.rows) ? node.rows.filter((row) => Array.isArray(row?.cells)) : [];
const cellsOf = (row: Row): Cell[] => row.cells ?? [];
const headerRow =
	node?.hasHeaderRow === true &&
	rows[0] !== undefined &&
	cellsOf(rows[0]).length > 0 &&
	cellsOf(rows[0]).every((cell) => cell.isHeader === true && (cell.rowspan ?? 1) === 1)
		? rows[0]
		: undefined;
const bodyRows = headerRow ? rows.slice(1) : rows;
const span = (value: number | undefined) => (typeof value === "number" && value > 1 ? value : undefined);
const cellText = (cell: Cell, index: number) => [
	{
		_type: "block",
		_key: cell._key ?? `cell-${index}`,
		style: "normal",
		children: Array.isArray(cell.content) ? cell.content : [],
		markDefs: [...(cell.markDefs ?? []), ...(node?.markDefs ?? [])],
	},
];
---

{
	rows.length > 0 && (
		<div class="table-scroll">
			<table>
				{headerRow && (
					<thead>
						<tr>
							{cellsOf(headerRow).map((cell, index) => (
								<th scope="col" colspan={span(cell.colspan)}>
									<PortableText value={cellText(cell, index)} components={{ block: TableCellText }} onMissingComponent={false} />
								</th>
							))}
						</tr>
					</thead>
				)}
				<tbody>
					{bodyRows.map((row) => (
						<tr>
							{cellsOf(row).map((cell, index) =>
								cell.isHeader ? (
									<th scope={index === 0 ? "row" : undefined} colspan={span(cell.colspan)} rowspan={span(cell.rowspan)}>
										<PortableText value={cellText(cell, index)} components={{ block: TableCellText }} onMissingComponent={false} />
									</th>
								) : (
									<td colspan={span(cell.colspan)} rowspan={span(cell.rowspan)}>
										<PortableText value={cellText(cell, index)} components={{ block: TableCellText }} onMissingComponent={false} />
									</td>
								),
							)}
						</tr>
					))}
				</tbody>
			</table>
		</div>
	)
}
