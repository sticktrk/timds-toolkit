---
/**
 * An image block: `{ _type: "image", asset: { _ref, url?, provider? }, alt?,
 * caption?, width?, height?, link? }`. Renders the stored file as it is, with
 * no transform, so it works the same on every adapter. A block without a
 * usable asset renders nothing.
 */
import { sanitizeHref } from "emdash";

import { imageBlockUrl } from "../../../lib/articles/index";

interface Props {
	node: {
		asset?: { _ref?: string; url?: string; src?: string; meta?: Record<string, unknown> };
		alt?: string;
		caption?: string;
		width?: number;
		height?: number;
		link?: string | { href?: string; blank?: boolean };
	};
}

const { node } = Astro.props;
const src = imageBlockUrl(node?.asset, Astro.locals);
const dimension = (value: unknown) =>
	typeof value === "number" && Number.isFinite(value) && value > 0 ? value : undefined;
const rawLink = typeof node?.link === "string" ? { href: node.link } : node?.link;
const href = rawLink?.href ? sanitizeHref(rawLink.href) : undefined;
const blank = Boolean(href && !href.startsWith("#") && typeof node?.link === "object" && node.link.blank);
const caption = typeof node?.caption === "string" && node.caption !== "" ? node.caption : undefined;
const alt = typeof node?.alt === "string" ? node.alt : "";
const width = dimension(node?.width);
const height = dimension(node?.height);
---

{
	src && (
		<figure>
			{href ? (
				<a href={href} target={blank ? "_blank" : undefined} rel={blank ? "noopener noreferrer" : undefined}>
					<img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
				</a>
			) : (
				<img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
			)}
			{caption && <figcaption>{caption}</figcaption>}
		</figure>
	)
}
