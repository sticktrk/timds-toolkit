---
/**
 * A link in an article body, as EmDash's own link mark renders it, with the
 * site's base path in front of a root-relative href (`/articles/` is
 * `/site/articles/` when the site is served under /site). Other hrefs are
 * kept as EmDash sanitizes them.
 */
import { sanitizeHref } from "emdash";

import { sitePath } from "../../../lib/articles/index";

interface Props {
	node: { markDef?: { href?: string; blank?: boolean } };
}

const { node } = Astro.props;
const sanitized = sanitizeHref(node?.markDef?.href);
const href = sanitized.startsWith("/") && !sanitized.startsWith("//") ? sitePath(sanitized) : sanitized;
// A same-page anchor never opens a new tab.
const blank = !href.startsWith("#") && Boolean(node?.markDef?.blank);
---

<a href={href} target={blank ? "_blank" : undefined} rel={blank ? "noopener noreferrer" : undefined}><slot /></a>
