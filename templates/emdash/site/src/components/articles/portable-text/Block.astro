---
/**
 * Paragraphs, headings and quotes, as plain elements. The article title is
 * the page's only h1 and a body goes no deeper than h3, so an h1 block
 * renders as h2 and h4 to h6 render as h3. Alignment from the editor is
 * dropped: the Design System sets text alignment.
 */
interface Props {
	node: { style?: string };
}

const style = Astro.props.node?.style ?? "normal";
const Tag =
	style === "h1" || style === "h2"
		? "h2"
		: style === "h3" || style === "h4" || style === "h5" || style === "h6"
			? "h3"
			: style === "blockquote"
				? "blockquote"
				: "p";
---

<Tag><slot /></Tag>
