---
/**
 * A code block: `{ _type: "code", code, language?, filename? }`. The language
 * and filename are not shown; a site that wants highlighting adds it here.
 */
interface Props {
	node: { code?: unknown };
}

const code = typeof Astro.props.node?.code === "string" ? Astro.props.node.code : "";
---

{code !== "" && <pre><code>{code}</code></pre>}
