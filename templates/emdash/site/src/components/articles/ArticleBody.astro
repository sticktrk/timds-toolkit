---
/**
 * The article body: EmDash's Portable Text component, with the elements an
 * article uses mapped onto plain markup that the Design System's `.prose`
 * styles. Links, strong, emphasis, inline code and lists keep EmDash's own
 * plain renderers. Other block types EmDash ships renderers for (embeds,
 * galleries, video and the like) keep those renderers; a type nobody knows
 * renders nothing.
 *
 * For a signed-in editor in edit mode, EmDash swaps this for its inline
 * editor on its own.
 */
import type { PortableTextBlock } from "emdash";
import { PortableText } from "emdash/ui";

import Block from "./portable-text/Block.astro";
import BlockquoteGroup from "./portable-text/BlockquoteGroup.astro";
import Break from "./portable-text/Break.astro";
import Code from "./portable-text/Code.astro";
import Image from "./portable-text/Image.astro";
import ListFallback from "./portable-text/ListFallback.astro";
import ListItemFallback from "./portable-text/ListItemFallback.astro";
import Nothing from "./portable-text/Nothing.astro";
import Passthrough from "./portable-text/Passthrough.astro";
import Table from "./portable-text/Table.astro";

interface Props {
	value: PortableTextBlock[] | null | undefined;
}

const value = Array.isArray(Astro.props.value) ? Astro.props.value : [];
const components = {
	block: Block,
	unknownBlock: Block,
	type: { image: Image, code: Code, table: Table, blockquoteGroup: BlockquoteGroup, break: Break },
	unknownType: Nothing,
	unknownMark: Passthrough,
	unknownList: ListFallback,
	unknownListItem: ListItemFallback,
};
---

<PortableText value={value} components={components} onMissingComponent={false} />
