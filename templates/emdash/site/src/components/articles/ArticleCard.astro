---
/**
 * One article in a list, as `li > article.article-card`: the cover when it
 * has one, the linked title, the summary, the date and byline, the topics.
 */
import type { ContentEntry } from "emdash";

import { articlePath, imageFieldUrl, topicsOf, type ArticleData } from "../../lib/articles/index";
import ArticleMeta from "./ArticleMeta.astro";
import TopicList from "./TopicList.astro";

interface Props {
	entry: ContentEntry<ArticleData>;
}

const { entry } = Astro.props;
const { data } = entry;
const cover = imageFieldUrl(data.cover, Astro.locals);
---

<li>
	<article class="article-card">
		{
			cover && (
				<img
					src={cover}
					alt={data.cover?.alt ?? ""}
					width={data.cover?.width}
					height={data.cover?.height}
					loading="lazy"
					decoding="async"
				/>
			)
		}
		<h2><a href={articlePath(entry.id)}>{data.title}</a></h2>
		{data.summary && <p>{data.summary}</p>}
		<ArticleMeta data={data} />
		<TopicList topics={topicsOf(data)} />
	</article>
</li>
