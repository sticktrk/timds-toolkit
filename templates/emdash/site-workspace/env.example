# Local development reads .dev.vars (git-ignored); copy this file there.
#
# EMDASH_ENCRYPTION_KEY encrypts plugin secrets stored in the database. Make
# one with `npx emdash secrets generate`, and keep a copy in a password
# manager: a database backup does not contain it. In production it is a
# secret on the Worker.
EMDASH_ENCRYPTION_KEY=

# The production origin, so setup and passkeys bind to it. Leave it empty in
# development; the site then uses the address of each request.
EMDASH_SITE_URL=

# The secret that lets POST /_scheduled run scheduled publishing and
# maintenance, for a platform that gives the Worker no Cron Trigger. Without
# it the path answers 404.
SCHEDULED_TASKS_SECRET=

# Optional. Set provider credentials as Worker secrets on the published site.
RESEND_API_KEY=
META_CAPI_ACCESS_TOKEN=
TURNSTILE_SECRET_KEY=

# Optional webhook. Use a public HTTPS endpoint and a dedicated authentication
# header. Set the header value as a Worker secret on the published site.
TIMDS_CONTACT_WEBHOOK_URL=
TIMDS_CONTACT_WEBHOOK_HEADER=
TIMDS_CONTACT_WEBHOOK_SECRET=
