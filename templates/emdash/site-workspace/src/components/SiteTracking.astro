---
import { env } from "cloudflare:workers";
import { browserTags, contact } from "../lib/contact/config";
import { providerDelivery, type ContactEnv } from "../lib/contact/runtime";

const production = contact.delivery === "production" && providerDelivery(env as unknown as ContactEnv, Astro.url.origin);
const tags = production ? browserTags() : null;
const attribution = production && contact.attribution && !Astro.url.searchParams.has("_preview");
---

<div hidden data-timds-tracking={JSON.stringify(tags)} data-timds-consent-required={String(contact.requireConsent)} data-timds-attribution={String(attribution)}></div>
