{
  "schemaVersion": 1,
  "id": "client-video",
  "name": "Client Video System",
  "fps": 30,
  "formats": {
    "longform": { "width": 1920, "height": 1080 },
    "cover": { "width": 3840, "height": 2160 },
    "short": { "width": 1080, "height": 1920 }
  },
  "package": {
    "shortCount": 1,
    "timeZone": "UTC",
    "longformDirectory": "Longform",
    "shortDirectoryPrefix": "Short form - "
  },
  "structure": {
    "longform": { "requireIntro": true, "requireOutro": false },
    "short": { "requireIntro": true, "requireOutro": false }
  },
  "copy": {
    "eyebrowWords": 5,
    "horizontalHeadlineWords": 8,
    "shortHeadlineWords": 4,
    "horizontalSublineWords": 10,
    "captionPageWords": 5,
    "coverHeadlineWords": 20,
    "coverHeadlineCharacters": 180,
    "coverMustBeQuestion": true
  },
  "brand": {
    "colors": {
      "background": "#101820",
      "panel": "rgba(16, 24, 32, 0.94)",
      "accent": "#d5b66f",
      "text": "#ffffff",
      "muted": "#e4e7eb"
    },
    "fonts": {
      "display": "Georgia, serif",
      "body": "Georgia, serif",
      "ui": "Arial, sans-serif"
    },
    "logo": "public/design-system/brand/logo.svg",
    "series": "Client series",
    "site": "example.com",
    "tagline": "A clear client-specific promise.",
    "watermark": {
      "left": "Client series",
      "right": "example.com"
    },
    "banners": {
      "longform": "Subscribe for more",
      "short": {
        "kicker": "Learn more",
        "url": "example.com"
      }
    }
  },
  "producer": {
    "schemaVersion": 1,
    "authoring": {
      "sharedPromptBlocks": [],
      "formatPromptBlocks": {
        "horizontal": [],
        "short": []
      }
    },
    "topicLabel": {
      "minimumWords": 2,
      "maximumWords": 4
    },
    "roleEyebrows": {
      "hook": "In brief",
      "rule": "The rule",
      "risk": "The risk",
      "process": "Next step",
      "exception": "The exception",
      "answer": "The answer"
    },
    "intro": {
      "enabled": true,
      "id": "intro"
    },
    "engagement": {
      "enabled": true,
      "formats": [
        "horizontal"
      ],
      "id": "engage",
      "eyebrow": "Your turn",
      "narrationTemplate": "{{question}} Tell us in the comments.",
      "requireYesNoQuestion": true
    },
    "outro": {
      "enabled": true,
      "id": "outro",
      "narrationTemplate": "Learn more about {{topic}} from {{series}} at {{site}}.",
      "narrationTemplates": {
        "short": "Learn more at {{site}}."
      }
    },
    "cover": {
      "eyebrow": "Client series",
      "defaultEmotion": "concern",
      "assetPrefix": "cover-subject-"
    },
    "footage": {
      "assetPrefix": "footage-"
    }
  },
  "publishing": {
    "articleLabel": "Read the full article:",
    "shortBridge": "Watch the full explainer for the complete answer.",
    "disclaimer": "",
    "shortDisclaimer": "",
    "shortArticleLink": true,
    "targets": {
      "youtube_short": {
        "brief": "Write a concise hook and payoff for this clip on YouTube Shorts. Do not instruct viewers to click a description URL. Do not promise a related video unless one is supplied.",
        "maxCharacters": 500,
        "maxCopyCharacters": 240
      },
      "facebook_reel": {
        "brief": "Write a self-contained Facebook Reel caption: introduce the situation and explain why this clip matters. Use a conversational, practical tone.",
        "maxCharacters": 800,
        "maxCopyCharacters": 360
      },
      "instagram_reel": {
        "brief": "Write a concise Instagram Reel caption with a strong opening and a useful takeaway. Do not invent a profile link or ask viewers to click a caption URL.",
        "maxCharacters": 600,
        "maxCopyCharacters": 240
      }
    },
    "targetDefaults": {
      "shortArticleLink": false
    }
  }
}
